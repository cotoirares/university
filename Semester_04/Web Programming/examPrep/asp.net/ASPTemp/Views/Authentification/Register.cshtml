@model ASPTemp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="text-center">
    <h1 class="display-4">Register Page</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="register-container">
        <div class="form-holder">
            <form asp-controller="Authentification" asp-action="Register" method="post" class="register-form">
                <div>
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" type="text" class="form-control" />
                </div>
                <div>
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <div>
                    <label asp-for="Age">Age</label>
                    <input asp-for="Age" type="number" class="form-control" />
                </div>
                <div>
                    <label asp-for="Skills">Skills</label>
                    <input asp-for="Skills" type="text" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary sbt-btn">Submit</button>
            </form>
        </div>
        <h3>Already have an account?</h3>
        <a asp-controller="Authentification" asp-action="Login">Login here</a>
    </div>
</div>

<style>
    .register-form {
        display: flex;
        justify-content: center;
        align-content: center;
        gap: 10px;
        width: 500px;
        flex-direction: column;
    }

    .register-container {
        margin-top: 70px;
        display: flex;
        align-content: center;
        justify-content: center;
        flex-direction: column;
    }

    .sbt-btn {
        margin-bottom: 10px;
    }

    .form-holder {
        display: flex;
        align-content: center;
        justify-content: center;
    }
</style>
